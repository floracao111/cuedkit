#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>
#include <avr/pgmspace.h>
#include "hanzi_table.h"   // generated by arduino/tools/gen_hanzi_table.py

// CuedKit cued speech: hand + arm.
// Serial Monitor: 115200 baud, line ending "Newline".
//
// Type Chinese characters (你好), pinyin syllables (hao, shuo, hua, ai), or both,
// separated by spaces: "ni hao" or "你好 ma". Each syllable shows the hand shape for
// the initial while the arm moves to the position for the final.
// Test commands:  1-8 = hand shape only      a1-a5 = arm position only
//                 rest = arm to rest pose    open / close = all fingers open / closed

Adafruit_PWMServoDriver pca = Adafruit_PWMServoDriver(0x40);

// ===== BEGIN HOST-TESTABLE TYPES =====
// (declared at the top so the Arduino IDE's auto-generated prototypes can see it)
struct Syllable {
  String initial;
  String glide;
  String realFinal;
  int hand;        // hand shape for the initial (1-8)
  int glideHand;   // hand shape for the glide (0 = no glide)
  int arm;         // arm position (1-5)
};
// ===== END HOST-TESTABLE TYPES =====

// ================== HAND CHANNELS ==================
const int CH_THUMB   = 0;
const int CH_INDEX   = 1;
const int CH_MIDDLE  = 2;
const int CH_RING    = 3;
const int CH_PINKY   = 4;
const int CH_LATERAL = 5;   // index lateral turn, only used by hand shape 8

// ================== HAND PWM VALUES ==================
const int THUMB_OPEN  = 500;
const int THUMB_CLOSE = 300;

const int FINGER_OPEN  = 500;   // middle, ring, pinky
const int FINGER_CLOSE = 150;

const int INDEX_OPEN_IN  = 300; // index open, lateral servo in  (hand shapes 1-7)
const int INDEX_OPEN_OUT = 400; // index open, lateral servo out (hand shape 8)
const int INDEX_CLOSE    = 100;

const int LATERAL_IN  = 500;
const int LATERAL_OUT = 460;

// ================== HAND SPEED ==================
// Each step moves every finger servo up to STEP_SIZE PWM units, then waits STEP_DELAY_MS.
// 12 units / 10 ms = about 1200 units per second (was 8 / 10 ms = 800, and 5 / 10 ms = 500 before that).
const int STEP_SIZE     = 12;
const int STEP_DELAY_MS = 10;

// ================== ARM CHANNELS / PWM ==================
const int NUM_ARM = 3;
const int ARM_CH[NUM_ARM] = {7, 8, 9};     // base, middle, top

// Rest pose: the "rest" command goes here. Also the fallback pose at the very first
// power-up, when the servo driver has no earlier position to read back.
const int REST_POS[NUM_ARM] = {525, 475, 325};

// The five positions, tested on the CuedKit arm. {base, middle, top}
const int ARM_POS[5][NUM_ARM] = {
  {485, 430, 350},   // position 1
  {470, 240, 560},   // position 2
  {530, 430, 460},   // position 3
  {530, 410, 510},   // position 4
  {530, 390, 570}    // position 5
};

// Hard limits per arm motor. Every arm move is clamped to these.
const int ARM_MIN[NUM_ARM] = {150, 150, 150};
const int ARM_MAX[NUM_ARM] = {600, 600, 600};

// ================== ARM SPEED ==================
// Each step moves every arm motor up to ARM_STEP_TICKS, then waits ARM_STEP_DELAY_MS.
// 3 ticks / 14 ms = about 214 ticks per second (was 2 / 12 ms = 167, and 1 / 10 ms = 100 before that).
// CuedData's old arm ran at roughly 200 ticks per second.
const int ARM_STEP_TICKS    = 3;
const int ARM_STEP_DELAY_MS = 14;

// Pauses used for glide syllables (first hand, arm, second hand), like CuedData.
const int PAUSE_AFTER_FIRST_HAND_MS   = 200;
const int PAUSE_BEFORE_SECOND_HAND_MS = 120;

// Pause between syllables when you type several at once.
const int SYLLABLE_GAP_MS = 250;

// Longest line accepted (bytes). A Chinese character is 3 bytes.
const int MAX_LINE_BYTES = 240;

// ================== STATE ==================
const int NUM_CH = 6;                  // hand channels 0-5
int currentPWM[NUM_CH];
int targetPWM[NUM_CH];
int currentArm[NUM_ARM];
bool gapPending = false;               // true once something was performed in this line

// ================== HAND CONTROL ==================
void moveToTargets() {
  bool moving = true;
  while (moving) {
    moving = false;
    for (int ch = 0; ch < NUM_CH; ch++) {
      if (currentPWM[ch] == targetPWM[ch]) continue;
      int diff = targetPWM[ch] - currentPWM[ch];
      if (diff > STEP_SIZE) diff = STEP_SIZE;
      if (diff < -STEP_SIZE) diff = -STEP_SIZE;
      currentPWM[ch] += diff;
      pca.setPWM(ch, 0, currentPWM[ch]);
      if (currentPWM[ch] != targetPWM[ch]) moving = true;
    }
    delay(STEP_DELAY_MS);
  }
}

void openThumb()  { targetPWM[CH_THUMB] = THUMB_OPEN; }
void closeThumb() { targetPWM[CH_THUMB] = THUMB_CLOSE; }

void openFinger(int ch)  { targetPWM[ch] = FINGER_OPEN; }
void closeFinger(int ch) { targetPWM[ch] = FINGER_CLOSE; }

// Hand shapes 1-7: index open with lateral servo in.
// The lateral servo only actually moves to bring it back after hand shape 8.
void openIndex() {
  targetPWM[CH_LATERAL] = LATERAL_IN;
  targetPWM[CH_INDEX] = INDEX_OPEN_IN;
}

// Hand shape 8 only: index open and turned laterally out.
void openIndexSpread() {
  targetPWM[CH_LATERAL] = LATERAL_OUT;
  targetPWM[CH_INDEX] = INDEX_OPEN_OUT;
}

// Index closed (hand shape 3): bring lateral back in if it was out.
void closeIndexSafe() {
  targetPWM[CH_LATERAL] = LATERAL_IN;
  targetPWM[CH_INDEX] = INDEX_CLOSE;
}

void hand1() { closeThumb(); openIndex();  closeFinger(CH_MIDDLE); closeFinger(CH_RING); closeFinger(CH_PINKY); }
void hand2() { closeThumb(); openIndex();  openFinger(CH_MIDDLE);  closeFinger(CH_RING); closeFinger(CH_PINKY); }
void hand3() { closeThumb(); closeIndexSafe(); openFinger(CH_MIDDLE); openFinger(CH_RING); openFinger(CH_PINKY); }
void hand4() { closeThumb(); openIndex();  openFinger(CH_MIDDLE);  openFinger(CH_RING);  openFinger(CH_PINKY); }
void hand5() { openThumb();  openIndex();  openFinger(CH_MIDDLE);  openFinger(CH_RING);  openFinger(CH_PINKY); }
void hand6() { openThumb();  openIndex();  closeFinger(CH_MIDDLE); closeFinger(CH_RING); closeFinger(CH_PINKY); }
void hand7() { openThumb();  openIndex();  openFinger(CH_MIDDLE);  closeFinger(CH_RING); closeFinger(CH_PINKY); }
void hand8() { closeThumb(); openIndexSpread(); openFinger(CH_MIDDLE); closeFinger(CH_RING); closeFinger(CH_PINKY); }

void showHand(int id) {
  switch (id) {
    case 1: hand1(); break;
    case 2: hand2(); break;
    case 3: hand3(); break;
    case 4: hand4(); break;
    case 5: hand5(); break;
    case 6: hand6(); break;
    case 7: hand7(); break;
    case 8: hand8(); break;
  }
  moveToTargets();
}

// ================== ARM CONTROL ==================
// Move all three arm motors together, clamped to the limits.
void moveArmTo(const int target[NUM_ARM]) {
  int goal[NUM_ARM];
  for (int m = 0; m < NUM_ARM; m++) {
    goal[m] = constrain(target[m], ARM_MIN[m], ARM_MAX[m]);
  }

  bool moving = true;
  while (moving) {
    moving = false;
    for (int m = 0; m < NUM_ARM; m++) {
      if (currentArm[m] == goal[m]) continue;
      int diff = goal[m] - currentArm[m];
      if (diff > ARM_STEP_TICKS) diff = ARM_STEP_TICKS;
      if (diff < -ARM_STEP_TICKS) diff = -ARM_STEP_TICKS;
      currentArm[m] += diff;
      pca.setPWM(ARM_CH[m], 0, currentArm[m]);
      if (currentArm[m] != goal[m]) moving = true;
    }
    delay(ARM_STEP_DELAY_MS);
  }
}

void showArm(int id) {
  if (id >= 1 && id <= 5) moveArmTo(ARM_POS[id - 1]);
}

// ===== BEGIN HOST-TESTABLE PARSER (tools/gen_hanzi_table.py compiles this block) =====
// ================== MAPPING (same as CuedData) ==================
int getHand(String s) {
  if (s == "p" || s == "d" || s == "zh") return 1;
  if (s == "k" || s == "q" || s == "z")  return 2;
  if (s == "h" || s == "r" || s == "s")  return 3;
  if (s == "n" || s == "b" || s == "yu") return 4;
  if (s == "t" || s == "m" || s == "f")  return 5;
  if (s == "w" || s == "l" || s == "x")  return 6;
  if (s == "g" || s == "ch" || s == "j") return 7;
  if (s == "sh" || s == "y" || s == "c") return 8;
  return 0;
}

int getArm(String s) {
  if (s == "an" || s == "e" || s == "o") return 1;
  if (s == "a" || s == "ou" || s == "er" || s == "en") return 2;
  if (s == "i" || s == "v" || s == "ang") return 3;
  if (s == "ai" || s == "u" || s == "ao") return 4;
  if (s == "eng" || s == "ong" || s == "ei") return 5;
  return 0;
}

// ================== PARSER (same as CuedData) ==================
// Returns true if the syllable can be cued.
bool parseSyllable(String input, Syllable &out) {
  String initial = "";
  String final = "";
  String glide = "";
  String realFinal = "";
  int handID = 0;

  // Empty initial (starts with a vowel: a, ai, an, e, er, o, ou ...):
  // always hand shape 5, and the whole syllable is the final.
  // Exactly "yi", "wu" and "yu" are spelled with y/w but pronounced i / u / ü, so they
  // are empty-initial syllables too (hand 5). Every other y.. / w.. syllable keeps y / w.
  if (input == "yi" || input == "wu" || input == "yu") {
    handID = 5;
    realFinal = (input == "yi") ? "i" : (input == "wu") ? "u" : "v";
  } else if (input.startsWith("a") || input.startsWith("o") || input.startsWith("e") ||
             input.startsWith("i") || input.startsWith("u") || input.startsWith("v")) {
    handID = 5;
    realFinal = input;
  } else {
    if (input.startsWith("yu")) {
      initial = "yu";
      final = input.substring(2);
    } else if (input.startsWith("zh") || input.startsWith("ch") || input.startsWith("sh")) {
      initial = input.substring(0, 2);
      final = input.substring(2);
    } else {
      initial = input.substring(0, 1);
      final = input.substring(1);
    }

    // After j, q, x the letter u is really ü: ju = jv, quan = qvan, xue = xve ...
    if ((initial == "j" || initial == "q" || initial == "x") && final.startsWith("u")) {
      final = "v" + final.substring(1);
    }

    realFinal = final;
    if (initial == "yu" && final == "n") realFinal = "en";   // yun = ü + en (like "vn")
    if (final != "") {
      if (final.length() > 1) {
        if (final == "ui") { glide = "w"; realFinal = "ei"; }
        else if (final == "iu") { glide = "y"; realFinal = "ou"; }
        else if (final == "un") { glide = "w"; realFinal = "en"; }
        else if (final == "ie") { glide = "y"; realFinal = "e"; }
        else if (final == "ve") { glide = "yu"; realFinal = "e"; }
        else if (final == "in") { glide = "y"; realFinal = "en"; }
        else if (final == "vn") { glide = "yu"; realFinal = "en"; }
        else if (final == "ing") { glide = "y"; realFinal = "eng"; }
        else if (final.startsWith("i")) { glide = "y"; realFinal = final.substring(1); }
        else if (final.startsWith("u")) { glide = "w"; realFinal = final.substring(1); }
        else if (final.startsWith("v")) { glide = "yu"; realFinal = final.substring(1); }
      }
      if (realFinal == "") {
        if (glide == "y") realFinal = "i";
        else if (glide == "w") realFinal = "u";
        else if (glide == "yu") realFinal = "v";
      }
    }
    handID = getHand(initial);
  }

  // Never show the same hand shape twice in a row: drop a glide that matches the initial
  // (yin, ying: y + y).
  if (glide != "" && getHand(glide) == handID) glide = "";

  out.initial = initial;
  out.glide = glide;
  out.realFinal = realFinal;
  out.hand = handID;
  out.glideHand = (glide != "") ? getHand(glide) : 0;
  out.arm = getArm(realFinal);
  return out.hand != 0 && out.arm != 0;
}
// ===== END HOST-TESTABLE PARSER =====

// ===== BEGIN HOST-TESTABLE HANZI LOOKUP =====
// Cue for one Chinese character (Unicode code point), from the generated table.
// Binary search over the sorted HANZI_CODE list in flash.
bool lookupHanzi(uint16_t cp, int &hand, int &glideHand, int &arm) {
  int lo = 0;
  int hi = HANZI_COUNT - 1;
  while (lo <= hi) {
    int mid = (lo + hi) / 2;
    uint16_t code = pgm_read_word(&HANZI_CODE[mid]);
    if (code == cp) {
      uint8_t idx = pgm_read_byte(&HANZI_CUE[mid]);
      uint16_t cue = pgm_read_word(&CUE_TABLE[idx]);
      hand = cue & 0x0F;
      glideHand = (cue >> 4) & 0x0F;
      arm = (cue >> 8) & 0x0F;
      return true;
    }
    if (code < cp) lo = mid + 1;
    else hi = mid - 1;
  }
  return false;
}
// ===== END HOST-TESTABLE HANZI LOOKUP =====

// ================== PERFORM ==================
// Pause between syllables of the same line (not before the first one).
void gapBetweenSyllables() {
  if (gapPending) delay(SYLLABLE_GAP_MS);
  gapPending = true;
}

// Same order as CuedData: hand first, then arm. With a glide: first hand, move arm,
// then second (glide) hand.
void performCue(int handID, int glideHand, int armID) {
  gapBetweenSyllables();
  if (glideHand != 0) {
    showHand(handID);
    delay(PAUSE_AFTER_FIRST_HAND_MS);
    showArm(armID);
    delay(PAUSE_BEFORE_SECOND_HAND_MS);
    showHand(glideHand);
  } else {
    showHand(handID);
    showArm(armID);
  }
}

void printCue(int handID, int glideHand, int armID) {
  Serial.print("hand ");
  Serial.print(handID);
  if (glideHand != 0) {
    Serial.print(" then hand ");
    Serial.print(glideHand);
  }
  Serial.print(", arm ");
  Serial.println(armID);
}

void performSyllable(String input) {
  Syllable s;
  if (!parseSyllable(input, s)) {
    Serial.print(input);
    Serial.println(": invalid input");
    return;
  }

  Serial.print(input);
  Serial.print(": initial=");  Serial.print(s.initial == "" ? "-" : s.initial);
  Serial.print(" glide=");     Serial.print(s.glide == "" ? "-" : s.glide);
  Serial.print(" final=");     Serial.print(s.realFinal == "" ? "-" : s.realFinal);
  Serial.print(" -> ");
  printCue(s.hand, s.glideHand, s.arm);

  performCue(s.hand, s.glideHand, s.arm);
}

// One typed word: a test command, or a pinyin syllable.
void handleWord(String word) {
  if (word.length() == 1 && word[0] >= '1' && word[0] <= '8') {
    gapBetweenSyllables();
    Serial.print("hand ");
    Serial.println(word);
    showHand(word[0] - '0');
  } else if (word.length() == 2 && word[0] == 'a' && word[1] >= '1' && word[1] <= '5') {
    gapBetweenSyllables();
    Serial.print("arm ");
    Serial.println(word[1]);
    showArm(word[1] - '0');
  } else if (word == "rest") {
    gapBetweenSyllables();
    moveArmTo(REST_POS);
    Serial.println("arm at rest");
  } else if (word == "open") {
    gapBetweenSyllables();
    hand5();
    moveToTargets();
    Serial.println("all open");
  } else if (word == "close") {
    gapBetweenSyllables();
    closeThumb();
    closeIndexSafe();
    closeFinger(CH_MIDDLE);
    closeFinger(CH_RING);
    closeFinger(CH_PINKY);
    moveToTargets();
    Serial.println("all closed");
  } else {
    performSyllable(word);
  }
}

// One Chinese character, given as its 3 UTF-8 bytes.
void handleHanzi(uint16_t cp, uint8_t b0, uint8_t b1, uint8_t b2) {
  int hand, glideHand, arm;
  Serial.write(b0);
  Serial.write(b1);
  Serial.write(b2);

  if (!lookupHanzi(cp, hand, glideHand, arm)) {
    Serial.println(": not in the character table");
    return;
  }

  Serial.print(": ");
  printCue(hand, glideHand, arm);
  performCue(hand, glideHand, arm);
}

// ================== LINE HANDLING ==================
// A line can mix Chinese characters and pinyin / test words, in any order.
// Everything else (spaces, punctuation, \r) just separates them.
void handleLine(const String &line) {
  int n = line.length();
  int i = 0;
  gapPending = false;

  while (i < n) {
    uint8_t b = (uint8_t)line[i];

    if ((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9')) {
      String word = "";
      while (i < n) {
        b = (uint8_t)line[i];
        if (b >= 'A' && b <= 'Z') b += 32;                       // lowercase
        if ((b >= 'a' && b <= 'z') || (b >= '0' && b <= '9')) {
          word += (char)b;
          i++;
        } else {
          break;
        }
      }
      handleWord(word);

    } else if (b >= 0xE0 && b < 0xF0 && i + 2 < n) {             // 3-byte UTF-8
      uint8_t b1 = (uint8_t)line[i + 1];
      uint8_t b2 = (uint8_t)line[i + 2];
      uint16_t cp = ((uint16_t)(b & 0x0F) << 12) | ((uint16_t)(b1 & 0x3F) << 6) | (b2 & 0x3F);
      if (cp >= 0x4E00 && cp <= 0x9FFF) handleHanzi(cp, b, b1, b2);  // Chinese only
      i += 3;

    } else if ((b & 0xE0) == 0xC0) {
      i += 2;                                                    // 2-byte UTF-8, ignore
    } else if ((b & 0xF8) == 0xF0) {
      i += 4;                                                    // 4-byte UTF-8, ignore
    } else {
      i++;                                                       // space, punctuation, \r
    }
  }
}

// ================== SAFE START ==================
// Reading a servo's PWM back from the driver chip: the PCA9685 keeps its last values
// when the Arduino resets or you upload new code, so we can start from where the
// servos really are instead of snapping them to a start pose.
const int PWM_VALID_MIN = 90;
const int PWM_VALID_MAX = 650;

bool readServoPWM(int ch, int &value) {
  uint16_t off = pca.getPWM(ch, true);     // the PWM "off" tick we last wrote
  if (off & 0x1000) return false;          // channel is fully off
  off &= 0x0FFF;
  if (off < PWM_VALID_MIN || off > PWM_VALID_MAX) return false;
  value = off;
  return true;
}

void safeStart() {
  bool anyUnknown = false;

  hand5();                                 // fills targetPWM with the default hand pose
  for (int ch = 0; ch < NUM_CH; ch++) {
    int v;
    if (readServoPWM(ch, v)) {
      currentPWM[ch] = v;                  // adopt where the finger already is
      targetPWM[ch] = v;                   // and do not move it
    } else {
      currentPWM[ch] = targetPWM[ch];      // no earlier position: use the default pose
      pca.setPWM(ch, 0, currentPWM[ch]);
      anyUnknown = true;
    }
  }

  for (int m = 0; m < NUM_ARM; m++) {
    int v;
    if (readServoPWM(ARM_CH[m], v)) {
      currentArm[m] = v;
    } else {
      currentArm[m] = REST_POS[m];
      pca.setPWM(ARM_CH[m], 0, currentArm[m]);
      anyUnknown = true;
    }
  }

  if (anyUnknown) {
    Serial.println("First power-up: some servos had no earlier position, set to the default pose.");
    Serial.println("(Make sure the hand and arm were already near it.)");
  } else {
    Serial.println("Safe start: kept every servo where it was, nothing moved.");
  }
}

// ================== SETUP / LOOP ==================
void setup() {
  Serial.begin(115200);
  Serial.setTimeout(50);

  pca.begin();
  pca.setPWMFreq(50);

  safeStart();

  Serial.println("CuedKit speech ready.");
  Serial.println("Type Chinese (你好) or pinyin (ni hao). Tests: 1-8, a1-a5, rest, open, close.");
}

void loop() {
  if (!Serial.available()) return;

  String line = Serial.readStringUntil('\n');
  if (line.length() == 0) return;

  if (line.length() > MAX_LINE_BYTES) {
    Serial.println("Line too long, send fewer characters at a time.");
    return;
  }

  handleLine(line);
  Serial.println("DONE");
}
